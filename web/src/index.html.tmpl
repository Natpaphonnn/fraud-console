<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{csp_meta}}
<title>Fraud Console · Fraud-E2E</title>
<meta name="description" content="A fraud-scoring console in the browser: a logistic model exported from the Python pipeline scores transactions live, with a cost-based step-up threshold, per-feature contributions and an uncertainty interval on every number.">
<meta name="author" content="Natpaphon Nukhunthod">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#0a0c0f">
<meta property="og:type" content="website">
<meta property="og:title" content="Fraud Console · cost-aware credit card fraud detection">
<meta property="og:description" content="Live in-browser scoring, a threshold simulator with illustrative costs, and a pre-registered evaluation on a public CC0 dataset.">
{{canonical_html}}
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="style.css">
<script src="theme.js"></script>
<script type="module" src="app.js"></script>
</head>
<body>
<!-- Generated by scripts/build_web.py from web/src/ and reports/. Do not edit; edit web/src/ and run `make docs`. -->
<a class="skip" href="#main" data-i18n="a11y.skip">[[a11y.skip]]</a>

<header class="topbar">
  <div class="bar">
    <a class="brand" href="#top" data-i18n-attr="aria-label:a11y.brand" aria-label="[[a11y.brand]]"><span class="brand-mark" aria-hidden="true"></span>FRAUD-E2E<span class="brand-sub">/console</span></a>
    <ul class="flags" data-i18n-attr="aria-label:flags.aria" aria-label="[[flags.aria]]">
      <li class="flag" data-i18n="flags.data">[[flags.data]]</li>
      <li class="flag flag--cost" data-i18n="flags.cost">[[flags.cost]]</li>
    </ul>
    <div class="bar-actions">
      <button type="button" class="cmd" id="open-palette" aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K">
        <span class="cmd-label" data-i18n="top.jump">[[top.jump]]</span><kbd id="cmd-key">Ctrl K</kbd></button>
      <button type="button" class="lang-btn" id="lang-toggle" lang="th" data-i18n-attr="title:top.lang_title;aria-label:top.lang_title" title="[[top.lang_title]]" aria-label="[[top.lang_title]]"><span class="lang-on" data-i18n="top.lang_current">[[top.lang_current]]</span><span class="lang-sep" aria-hidden="true">/</span><span class="lang-off" data-i18n="top.lang_other">[[top.lang_other]]</span></button>
      <button type="button" class="icon-btn" id="theme-toggle" aria-pressed="false" data-i18n-attr="title:top.theme_title" title="[[top.theme_title]]">
        <span class="sr-only" data-i18n="top.theme_sr">[[top.theme_sr]]</span><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z"/></svg></button>
    </div>
  </div>
</header>

<main id="main">

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-head">
      <p class="kicker" data-i18n="hero.kicker">[[hero.kicker]]</p>
      <h1 id="hero-title" data-i18n="hero.title">[[hero.title]]</h1>
      <p class="hero-sub" data-i18n="hero.sub">[[hero.sub]]</p>
    </div>

    <div class="panel flow" id="flow" aria-labelledby="flow-title">
      <div class="panel-head">
        <h2 class="panel-title" id="flow-title" data-i18n="flow.title">[[flow.title]]</h2>
        <div class="seg" role="radiogroup" data-i18n-attr="aria-label:flow.view_aria" aria-label="[[flow.view_aria]]">
          <button type="button" role="radio" data-view="all" aria-checked="true" disabled data-i18n="flow.view_all">[[flow.view_all]]</button>
          <button type="button" role="radio" data-view="sample" aria-checked="false" disabled data-i18n="flow.view_sample">[[flow.view_sample]]</button>
        </div>
      </div>
      <p class="panel-meta" id="flow-note" data-i18n="flow.note">[[flow.note]]</p>
      <p class="flow-filter" id="flow-filter" hidden data-i18n="flow.filter">[[flow.filter]]</p>
      <p class="flow-filter" id="flow-static" hidden data-i18n="flow.static">[[flow.static]]</p>
      <div class="flow-box"><canvas id="flow-canvas" aria-hidden="true"></canvas></div>
    </div>

    <div class="console">
      <div class="panel stream" id="stream" aria-labelledby="stream-title">
        <div class="panel-head">
          <h2 class="panel-title" id="stream-title"><span class="live" id="live-dot" aria-hidden="true"></span><span data-i18n="stream.title">[[stream.title]]</span></h2>
          <div class="controls" role="group" data-i18n-attr="aria-label:stream.controls_aria" aria-label="[[stream.controls_aria]]">
            <button type="button" id="s-play" class="btn" aria-keyshortcuts="P" disabled>[[js.play.pause]]</button>
            <button type="button" id="s-step" class="btn" aria-keyshortcuts="." disabled data-i18n="stream.step">[[stream.step]]</button>
            <div class="seg" role="radiogroup" data-i18n-attr="aria-label:stream.speed_aria" aria-label="[[stream.speed_aria]]">
              <button type="button" role="radio" data-speed="1" aria-checked="true" disabled>1×</button>
              <button type="button" role="radio" data-speed="4" aria-checked="false" disabled>4×</button>
              <button type="button" role="radio" data-speed="16" aria-checked="false" disabled>16×</button>
            </div>
            <button type="button" id="s-restart" class="btn btn--ghost" disabled data-i18n="stream.restart">[[stream.restart]]</button>
          </div>
        </div>
        <p class="panel-meta"><span data-i18n="stream.meta">[[stream.meta]]</span> · <span id="s-progress"></span></p>
        <div class="strip" id="strip">
          <div class="strip-head"><span class="k" data-i18n="strip.title">[[strip.title]]</span>
            <span class="fine" data-i18n="strip.help">[[strip.help]]</span></div>
          <div class="strip-plot">
            <canvas aria-hidden="true"></canvas>
            <div class="strip-handle" role="slider" tabindex="0" data-i18n-attr="aria-label:strip.handle_aria" aria-label="[[strip.handle_aria]]"
                 aria-valuemin="0" aria-valuemax="1" aria-valuenow="0"><span class="strip-grip"></span></div>
          </div>
          <div class="strip-axis" aria-hidden="true"><span style="left:0%">0.0001</span><span style="left:25%">0.001</span><span style="left:50%">0.01</span><span style="left:75%">0.1</span><span style="left:100%">1</span></div>
        </div>
        <p class="legend-line" id="s-legend"><span class="lg-item"><span class="o o--tp">●</span><span data-i18n="legend.tp">[[legend.tp]]</span></span>
          <span class="lg-item"><span class="o o--fn">×</span><span data-i18n="legend.fn">[[legend.fn]]</span></span>
          <span class="lg-item"><span class="o o--fp">○</span><span data-i18n="legend.fp">[[legend.fp]]</span></span>
          <span class="lg-item"><span class="o o--tn">·</span><span data-i18n="legend.tn">[[legend.tn]]</span></span>
          <span class="lg-item lg-bar"><span class="lg-swatch" aria-hidden="true"></span><span data-i18n="legend.bar">[[legend.bar]]</span></span></p>
        <div class="srow srow--head" aria-hidden="true">
          <span data-i18n="col.txn">[[col.txn]]</span><span class="r" data-i18n="col.amount">[[col.amount]]</span><span class="c-merch" data-i18n="col.merchant">[[col.merchant]]</span><span class="c-chan" data-i18n="col.channel">[[col.channel]]</span><span data-i18n-attr="title:col.score_title" title="[[col.score_title]]"><span data-i18n="col.score">[[col.score]]</span> <span class="c-scale" data-i18n="col.scale">[[col.scale]]</span><span class="c-scale-s" data-i18n="col.scale_s">[[col.scale_s]]</span></span><span data-i18n="col.decision">[[col.decision]]</span><span class="c-out" data-i18n="col.truth">[[col.truth]]</span>
        </div>
        <ol class="stream-rows" id="s-rows" data-i18n-attr="aria-label:stream.rows_aria" aria-label="[[stream.rows_aria]]"></ol>
        <p class="stream-hint" id="s-hint" hidden></p>
        <p class="fine stream-foot" data-i18n="stream.foot">[[stream.foot]]</p>
      </div>

      <div class="side">
        <div class="panel counters" aria-labelledby="ctr-title">
          <div class="panel-head">
            <h2 class="panel-title" id="ctr-title" data-i18n="ctr.title">[[ctr.title]]</h2>
          </div>
          <label class="thr-mini" for="thr-mini">
            <span class="k" data-i18n="ctr.threshold">[[ctr.threshold]]</span><output class="v" id="thr-mini-out" for="thr-mini">{{threshold}}</output>
          </label>
          <input type="range" id="thr-mini" min="0" max="1" step="1" value="0" data-i18n-attr="aria-label:ctr.thr_aria" aria-label="[[ctr.thr_aria]]" disabled>

          <div class="ctr-block" aria-labelledby="full-title">
            <h3 class="ctr-title" id="full-title"><span class="scope scope--full" data-i18n="ctr.full">[[ctr.full]]</span>
              <span class="ctr-meta" data-i18n="ctr.full_meta">[[ctr.full_meta]]</span></h3>
            <p class="fine scope-note" data-i18n="ctr.full_note">[[ctr.full_note]]</p>
            <dl class="ctr-grid ctr-grid--2">
              <div><dt data-i18n="ctr.recall">[[ctr.recall]]</dt><dd id="f-recall">—</dd></div>
              <div><dt data-i18n="ctr.precision">[[ctr.precision]]</dt><dd id="f-precision">—</dd></div>
              <div><dt data-i18n="ctr.stepped">[[ctr.stepped]]</dt><dd id="f-alert">—</dd></div>
              <div><dt data-i18n="ctr.cost">[[ctr.cost]]</dt><dd id="f-cost">—</dd></div>
            </dl>
            <p class="fine" id="f-counts"></p>
          </div>

          <div class="ctr-block" aria-labelledby="played-title">
            <h3 class="ctr-title" id="played-title"><span class="scope" data-i18n="ctr.played">[[ctr.played]]</span>
              <span class="ctr-meta" id="c-played"></span></h3>
            <dl class="ctr-grid">
              <div><dt data-i18n="ctr.tp">[[ctr.tp]]</dt><dd id="c-tp">0</dd></div>
              <div><dt data-i18n="ctr.fn">[[ctr.fn]]</dt><dd id="c-fn">0</dd></div>
              <div><dt data-i18n="ctr.fp">[[ctr.fp]]</dt><dd id="c-fp">0</dd></div>
              <div><dt data-i18n="ctr.tn">[[ctr.tn]]</dt><dd id="c-tn">0</dd></div>
              <div><dt data-i18n="ctr.recall">[[ctr.recall]]</dt><dd id="c-recall">—</dd></div>
              <div><dt data-i18n="ctr.precision">[[ctr.precision]]</dt><dd id="c-precision">—</dd></div>
            </dl>
          </div>
          <figure class="conv" id="conv">
            <figcaption><span class="k" data-i18n="conv.title">[[conv.title]]</span>
              <span class="conv-key"><i class="ck ck--recall"></i><span data-i18n="ctr.recall">[[ctr.recall]]</span> <i class="ck ck--precision"></i><span data-i18n="ctr.precision">[[ctr.precision]]</span>
              <i class="ck ck--ref"></i><span data-i18n="conv.key">[[conv.key]]</span></span></figcaption>
            <div class="conv-box"></div>
          </figure>
          <p class="fine" data-i18n="ctr.foot">[[ctr.foot]]</p>
        </div>

        <div class="panel inspector" id="inspector" aria-labelledby="insp-title">
          <div class="panel-head">
            <h2 class="panel-title" id="insp-title" data-i18n="insp.title">[[insp.title]]</h2>
            <span class="pill" id="insp-mode">[[js.insp.following]]</span>
          </div>
          <div id="insp-body"><p class="fine">[[js.insp.waiting]]</p></div>
        </div>
      </div>
    </div>
    <noscript><p class="fine">[[hero.noscript]]</p></noscript>
  </div>
</section>

<section class="wrap block" id="metrics" aria-labelledby="metrics-title">
  <div class="block-head"><span class="idx">01</span><h2 id="metrics-title" data-i18n="metrics.title">[[metrics.title]]</h2>
    <p class="block-sub" data-i18n="metrics.sub">[[metrics.sub]]</p></div>
  <ul class="stats">
    <li><span class="k" data-i18n="metrics.prauc">[[metrics.prauc]]</span><span class="v">{{ho_pr_auc}}</span><span class="ci" data-i18n="metrics.prauc_ci">[[metrics.prauc_ci]]</span></li>
    <li><span class="k" data-i18n="metrics.rocauc">[[metrics.rocauc]]</span><span class="v">{{ho_roc_auc}}</span><span class="ci" data-i18n="metrics.rocauc_ci">[[metrics.rocauc_ci]]</span></li>
    <li><span class="k" data-i18n="metrics.recall">[[metrics.recall]]</span><span class="v">{{ho_recall}}</span><span class="ci" data-i18n="metrics.recall_ci">[[metrics.recall_ci]]</span></li>
    <li><span class="k" data-i18n="metrics.saving">[[metrics.saving]]</span><span class="v">{{cv_saving}}</span><span class="ci" data-i18n="metrics.saving_ci">[[metrics.saving_ci]]</span></li>
  </ul>
</section>

<section class="wrap block" id="simulator" aria-labelledby="sim-title">
  <div class="block-head"><span class="idx">02</span><h2 id="sim-title" data-i18n="sim.title">[[sim.title]]</h2>
    <p class="block-sub" data-i18n="sim.sub">[[sim.sub]]</p></div>
  <p class="callout" role="note" data-i18n="sim.callout">[[sim.callout]]</p>

  <div class="sim" id="sim">
    <form class="sim-controls" id="sim-form" autocomplete="off">
      <div class="panel field--threshold">
        <label for="thr" class="thr-label"><span class="k" data-i18n="sim.thr_label">[[sim.thr_label]]</span> <output id="thr-out" for="thr">{{threshold}}</output></label>
        <input type="range" id="thr" name="thr" min="0" max="1" step="1" value="0" disabled aria-describedby="thr-help">
        <p class="fine" id="thr-help" data-i18n="sim.thr_help">[[sim.thr_help]]</p>
        <div class="buttons">
          <button type="button" class="btn" id="btn-best" disabled data-i18n="sim.btn_best">[[sim.btn_best]]</button>
          <button type="button" class="btn btn--ghost" id="btn-project" disabled data-i18n="sim.btn_project">[[sim.btn_project]]</button>
        </div>
        <p class="fine best-note" id="o-best"></p>
      </div>
      <fieldset class="panel costs">
        <legend><span class="k" data-i18n="sim.costs">[[sim.costs]]</span> <span class="muted" data-i18n="sim.costs_unit">[[sim.costs_unit]]</span></legend>
        <label class="field"><span data-i18n="sim.c_review">[[sim.c_review]]</span>
          <input type="number" id="c-review" name="review_cost_per_alert" min="0" step="1" value="{{cost_review}}" inputmode="decimal" disabled></label>
        <label class="field"><span data-i18n="sim.c_friction">[[sim.c_friction]]</span>
          <input type="number" id="c-friction" name="fp_friction_cost" min="0" step="1" value="{{cost_friction}}" inputmode="decimal" disabled></label>
        <label class="field"><span data-i18n="sim.c_fnfrac">[[sim.c_fnfrac]]</span>
          <input type="number" id="c-fnfrac" name="fn_loss_fraction" min="0" max="2" step="0.1" value="{{cost_fn_frac}}" inputmode="decimal" disabled></label>
        <label class="field"><span data-i18n="sim.c_fnfixed">[[sim.c_fnfixed]]</span>
          <input type="number" id="c-fnfixed" name="fn_fixed_cost" min="0" step="1" value="{{cost_fn_fixed}}" inputmode="decimal" disabled></label>
        <button type="reset" class="btn btn--ghost" id="btn-reset" disabled data-i18n="sim.reset">[[sim.reset]]</button>
        <p class="error" id="cost-error" role="alert" hidden></p>
      </fieldset>
    </form>

    <div class="sim-out">
      <ul class="stats stats--sim" aria-live="polite">
        <li><span class="k" data-i18n="sim.o_recall">[[sim.o_recall]]</span><span class="v" id="o-recall">{{cv_recall}}</span></li>
        <li><span class="k" data-i18n="sim.o_precision">[[sim.o_precision]]</span><span class="v" id="o-precision">{{cv_precision}}</span></li>
        <li><span class="k" data-i18n="sim.o_alert">[[sim.o_alert]]</span><span class="v" id="o-alert">{{cv_alert_rate}}</span></li>
        <li><span class="k" data-i18n="sim.o_cost">[[sim.o_cost]]</span><span class="v" id="o-cost">{{cv_cost_per_1000}}</span>
          <span class="ci" id="o-cost-sub"></span></li>
      </ul>
      <p class="fine sim-sentence" id="o-sentence"></p>
      <figure class="panel chart">
        <figcaption><span class="k" data-i18n="sim.chart_title">[[sim.chart_title]]</span> <span class="muted" data-i18n="sim.chart_sub">[[sim.chart_sub]]</span></figcaption>
        <div class="chart-box" id="cost-chart"></div>
        <div class="legend" aria-hidden="true">
          <span><i class="key key--line"></i><span data-i18n="sim.lg_model">[[sim.lg_model]]</span></span>
          <span><i class="key key--ref"></i><span data-i18n="sim.lg_nobody">[[sim.lg_nobody]]</span></span>
          <span><i class="key key--now"></i><span data-i18n="sim.lg_now">[[sim.lg_now]]</span></span>
          <span><i class="key key--best"></i><span data-i18n="sim.lg_best">[[sim.lg_best]]</span></span>
        </div>
      </figure>
      <figure class="panel chart pr" id="pr">
        <figcaption><span class="k" data-i18n="pr.title">[[pr.title]]</span> <span class="muted" data-i18n="pr.sub">[[pr.sub]]</span></figcaption>
        <div class="pr-box"></div>
      </figure>
    </div>
  </div>
</section>

<section class="wrap block" id="playground" aria-labelledby="pg-title">
  <div class="block-head"><span class="idx">03</span><h2 id="pg-title" data-i18n="pg.title">[[pg.title]]</h2>
    <p class="block-sub" data-i18n="pg.sub">[[pg.sub]]</p></div>
  <div class="pg">
    <form class="panel pg-form" id="pg-form" autocomplete="off" data-i18n-attr="aria-label:pg.form_aria" aria-label="[[pg.form_aria]]">
      <div class="pg-presets" role="group" data-i18n-attr="aria-label:pg.load_aria" aria-label="[[pg.load_aria]]">
        <span class="k" data-i18n="pg.load">[[pg.load]]</span>
        <button type="button" class="btn btn--ghost" data-preset="fraud" disabled data-i18n="pg.p_fraud">[[pg.p_fraud]]</button>
        <button type="button" class="btn btn--ghost" data-preset="legit" disabled data-i18n="pg.p_legit">[[pg.p_legit]]</button>
        <button type="button" class="btn btn--ghost" data-preset="inspector" disabled data-i18n="pg.p_insp">[[pg.p_insp]]</button>
      </div>
      <div class="pg-fields" id="pg-fields"></div>
    </form>
    <div class="panel pg-out" aria-live="polite">
      <div class="pg-score">
        <span class="k" data-i18n="pg.score">[[pg.score]]</span><span class="v" id="pg-score">—</span>
        <span class="decision" id="pg-decision">—</span>
      </div>
      <div class="gauge" id="pg-gauge" aria-hidden="true"><span class="gauge-thr"></span><span class="gauge-dot"></span></div>
      <p class="fine" id="pg-note"></p>
      <div id="pg-contrib"></div>
    </div>
  </div>
</section>

<section class="wrap block report" id="report" aria-labelledby="report-title">
  <div class="block-head"><span class="idx">04</span><h2 id="report-title" data-i18n="rep.title">[[rep.title]]</h2>
    <p class="block-sub" data-i18n="rep.sub">[[rep.sub]]</p></div>

  <details class="module" id="r-problem">
    <summary><span class="m-idx">04.1</span><span class="m-title" data-i18n="r1.title">[[r1.title]]</span><span class="m-sub" data-i18n="r1.sub">[[r1.sub]]</span></summary>
    <div class="prose" data-i18n="r1.body">[[r1.body]]</div>
  </details>

  <details class="module" id="r-data">
    <summary><span class="m-idx">04.2</span><span class="m-title" data-i18n="r2.title">[[r2.title]]</span><span class="m-sub" data-i18n="r2.sub">[[r2.sub]]</span></summary>
    <div class="prose" data-i18n="r2.body">[[r2.body]]</div>
  </details>

  <details class="module" id="r-results">
    <summary><span class="m-idx">04.3</span><span class="m-title" data-i18n="r3.title">[[r3.title]]</span><span class="m-sub" data-i18n="r3.sub">[[r3.sub]]</span></summary>
    <div class="prose" data-i18n="r3.body">[[r3.body]]</div>
  </details>

  <details class="module" id="r-drivers">
    <summary><span class="m-idx">04.4</span><span class="m-title" data-i18n="r4.title">[[r4.title]]</span><span class="m-sub" data-i18n="r4.sub">[[r4.sub]]</span></summary>
    <div class="prose" data-i18n="r4.body">[[r4.body]]</div>
  </details>

  <details class="module" id="r-didnt-work">
    <summary><span class="m-idx">04.5</span><span class="m-title" data-i18n="r5.title">[[r5.title]]</span><span class="m-sub" data-i18n="r5.sub">[[r5.sub]]</span></summary>
    <div class="prose" data-i18n="r5.body">[[r5.body]]</div>
  </details>

  <details class="module" id="r-fairness">
    <summary><span class="m-idx">04.6</span><span class="m-title" data-i18n="r6.title">[[r6.title]]</span><span class="m-sub" data-i18n="r6.sub">[[r6.sub]]</span></summary>
    <div class="prose" data-i18n="r6.body">[[r6.body]]</div>
  </details>

  <details class="module" id="r-method">
    <summary><span class="m-idx">04.7</span><span class="m-title" data-i18n="r7.title">[[r7.title]]</span><span class="m-sub" data-i18n="r7.sub">[[r7.sub]]</span></summary>
    <div class="prose" data-i18n="r7.body">[[r7.body]]</div>
  </details>
</section>

</main>

<footer class="footer" id="credits">
  <div class="wrap">
    {{links_html}}
    <p data-i18n="foot.data">[[foot.data]]</p>
    <p data-i18n="foot.costs">[[foot.costs]]</p>
    <p data-i18n="foot.font">[[foot.font]]</p>
    <p class="muted" data-i18n="foot.meta">[[foot.meta]]</p>
  </div>
</footer>

<dialog class="palette" id="palette" data-i18n-attr="aria-label:pal.aria" aria-label="[[pal.aria]]">
  <div class="pal-in">
    <input type="text" id="pal-input" role="combobox" aria-expanded="true" aria-controls="pal-list"
           aria-autocomplete="list" data-i18n-attr="placeholder:pal.placeholder" placeholder="[[pal.placeholder]]" autocomplete="off" spellcheck="false">
    <ul id="pal-list" role="listbox" data-i18n-attr="aria-label:pal.list_aria" aria-label="[[pal.list_aria]]"></ul>
    <p class="pal-foot" data-i18n="pal.foot">[[pal.foot]]</p>
  </div>
</dialog>

<script type="application/json" id="site-data">{{data_json}}</script>
</body>
</html>
